      "human_rubric": {"invariants": "Connects awaited operations to result flags.", "edge_cases": "Distinguishes absent and non-incremental summary stores.", "uncertainty": "Avoids claiming rollback.", "implications": "Explains reporting semantics."}
    },
    {
      "id": "repository-cleanup-hard",
      "family_id": "repository-cleanup",
      "difficulty": "hard",
      "description": "Reason about partial cleanup failure and retry.",
      "prompt": "Assume vector cleanup throws after graph and content cleanup succeeded. Explain what state remains, whether a result is returned, whether registry deletion occurs, and what a retry would do based only on the implementation and tests.",
      "targets": [{"file_path": "src/CodeMesh.Ingestion/RepositoryCleanupService.cs"}, {"file_path": "tests/CodeMesh.Tests/Program.cs"}],
      "expected_facts": {"result_returned": false, "registry_deleted": false, "graph_content_already_cleaned": true, "automatic_rollback": false},
      "forbidden_substrings": ["transaction rolls back", "registry is always deleted"],
      "tool_policy": {"allowed_tools": ["codemesh_search_context", "codemesh_get_context_package", "codemesh_get_neighbors"], "max_calls": 6},
      "human_rubric": {"invariants": "Follows sequential awaits and exception propagation.", "edge_cases": "Discusses retry only where supported.", "uncertainty": "Separates likely idempotence from proven behavior.", "implications": "Identifies partial-state operational risk."}
    },
