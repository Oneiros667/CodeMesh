{
  "schema_version": "1.0",
  "kind": "model-benchmark",
  "name": "codemesh-model",
  "description": "Two-tier CodeMesh-backed model benchmark with query and change difficulty ladders.",
  "repository_id": "code_mesh",
  "weights": {
    "accuracy": 35,
    "instruction_following": 15,
    "tool_use": 15,
    "safety": 10,
    "insight": 10,
    "reliability": 5,
    "token_efficiency": 5,
    "speed": 5
  },
  "thresholds": {
    "query_score": 75,
    "change_score": 70,
    "query_minimums": {"easy": 7, "medium": 6, "hard": 4},
    "change_minimums": {"easy": 2, "medium": 2, "hard": 2},
    "minimum_repetitions": 3
  },
  "questions": [
    {
      "id": "registry-persistence-easy",
      "family_id": "registry-persistence",
      "difficulty": "easy",
      "description": "Identify the Mongo repository identity field.",
      "prompt": "Identify the exact field MongoRegistryStore.UpsertRepositoryAsync uses to match an existing repository document. Cite the method.",
      "targets": [{"file_path": "src/CodeMesh.Storage/Mongo/MongoRegistryStore.cs"}],
      "expected_facts": {"lookup_field": "RepositoryId"},
      "forbidden_substrings": ["keyed on alias", "filter on alias"],
      "tool_policy": {"allowed_tools": ["codemesh_search_symbols", "codemesh_get_context_package"], "max_calls": 2, "per_tool_limits": {"codemesh_search_symbols": 1, "codemesh_get_context_package": 1}},
      "human_rubric": {"invariants": "Identifies repository identity correctly.", "edge_cases": "Avoids confusing mutable alias with identity.", "uncertainty": "Does not speculate beyond the method.", "implications": "Explains why repeated ingestion updates one record."}
    },
    {
      "id": "registry-persistence-medium",
      "family_id": "registry-persistence",
      "difficulty": "medium",
      "description": "Explain registry record construction and upsert behavior.",
      "prompt": "Explain how WriteRegistryAsync constructs repository and run records, then distinguish Mongo fields written only on insert from fields refreshed on every ingestion.",
      "targets": [{"file_path": "src/CodeMesh.Ingestion/IngestionOrchestrator.cs"}, {"file_path": "src/CodeMesh.Storage/Mongo/MongoRegistryStore.cs"}],
      "expected_facts": {"lookup_field": "RepositoryId", "insert_only": ["RepositoryId", "FirstSeenAtUtc"], "writes_run_record": true},
      "forbidden_substrings": ["filter on alias"],
      "tool_policy": {"allowed_tools": ["codemesh_search_context", "codemesh_get_context_package", "codemesh_get_neighbors"], "max_calls": 4},
      "human_rubric": {"invariants": "Separates identity, first-seen, mutable fields and run history.", "edge_cases": "Notes optional embedding count.", "uncertainty": "Labels any behavior not in the snippets.", "implications": "Explains insert-versus-refresh semantics."}
    },
    {
      "id": "registry-persistence-hard",
      "family_id": "registry-persistence",
      "difficulty": "hard",
      "description": "Reason about two sequential registry writes.",
      "prompt": "A repository is ingested twice with the same RepositoryId. The second run changes branch and commit and omits EmbeddingCount. Determine which identity and timestamps remain, which fields change, and what happens to the stored embedding count.",
      "targets": [{"file_path": "src/CodeMesh.Ingestion/IngestionOrchestrator.cs"}, {"file_path": "src/CodeMesh.Storage/Mongo/MongoRegistryStore.cs"}],
      "expected_facts": {"identity_preserved": true, "first_seen_preserved": true, "branch_commit_updated": true, "embedding_count_when_omitted": "preserved"},
      "forbidden_substrings": ["embedding count is cleared", "new document per alias"],
      "tool_policy": {"allowed_tools": ["codemesh_search_context", "codemesh_get_context_package", "codemesh_get_node", "codemesh_get_neighbors"], "max_calls": 6},
      "human_rubric": {"invariants": "Correctly applies SetOnInsert and conditional Set across two writes.", "edge_cases": "Handles absent optional embedding count.", "uncertainty": "States assumptions about equal RepositoryId.", "implications": "Explains the resulting Mongo document."}
    },
    {
      "id": "repository-cleanup-easy",
      "family_id": "repository-cleanup",
      "difficulty": "easy",
      "description": "List stores affected by repository cleanup.",
      "prompt": "List the stores RepositoryCleanupService cleans when deleting an indexed repository and identify which store is deleted last.",
      "targets": [{"file_path": "src/CodeMesh.Ingestion/RepositoryCleanupService.cs"}],
      "expected_facts": {"stores": ["graph", "content", "vectors", "summaries", "registry"], "last_store": "registry"},
      "forbidden_substrings": [],
      "tool_policy": {"allowed_tools": ["codemesh_search_symbols", "codemesh_get_context_package"], "max_calls": 2},
      "human_rubric": {"invariants": "Names all configured stores.", "edge_cases": "Notes summaries are optional.", "uncertainty": "Does not invent transactional behavior.", "implications": "Identifies registry deletion order."}
    },
    {
      "id": "repository-cleanup-medium",
      "family_id": "repository-cleanup",
      "difficulty": "medium",
      "description": "Trace cleanup ordering and result flags.",
      "prompt": "Trace repository cleanup in execution order and explain when each RepositoryCleanupResult flag becomes true, including the optional summary-store case.",
      "targets": [{"file_path": "src/CodeMesh.Ingestion/RepositoryCleanupService.cs"}, {"file_path": "tests/CodeMesh.Tests/Program.cs"}],
      "expected_facts": {"order": ["graph", "content", "vectors", "summaries", "registry"], "summaries_cleaned_without_store": false, "registry_entry_checked_first": true},
