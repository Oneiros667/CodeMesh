{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "MD013": false,
    "MD024": {
      "siblings_only": true
    }
  },
  "ignores": [
    "**/.git/**",
    "**/.tmp/**",
    "**/.venv/**",
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**",
    "**/build/**",
    "**/dist/**",
    "**/coverage/**",
    "**/vendor/**",
    "**/generated/**",
    "**/runtime/**",
    ".codemesh-evals/**",
    ".codemesh-smoke/**",
    ".codemesh-live-summary/**",
    "references/**"
  ]
}
